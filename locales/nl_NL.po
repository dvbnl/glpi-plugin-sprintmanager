msgid "Only needed above %s%% capacity. The Scrum Master reviews it when the item is assigned to the sprint."
msgstr "Alleen nodig boven %s%% capaciteit. De Scrum Master beoordeelt het bij het toewijzen aan de sprint."

#: src/SprintAssignGuard.php src/SprintAgility.php
msgid "Reason above the maximum"
msgstr "Onderbouwing boven het maximum"

#: src/SprintAssignGuard.php src/SprintAgility.php
msgid "Reason needed"
msgstr "Onderbouwing nodig"

#: src/SprintAssignGuard.php src/SprintAgility.php
msgid "Retrospective"
msgstr "Retrospective"

#: src/SprintAssignGuard.php src/SprintAgility.php
msgid "Set owner"
msgstr "Eigenaar kiezen"

