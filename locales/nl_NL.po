msgid "%1$s has %2$s credits for %3$s. With these items the planned total comes to %4$s credits (%5$s over)."
msgstr "%1$s heeft %2$s credits voor %3$s. Met deze items komt het geplande totaal op %4$s credits (%5$s te veel)."

#: src/SprintAssignGuard.php src/SprintAgility.php
