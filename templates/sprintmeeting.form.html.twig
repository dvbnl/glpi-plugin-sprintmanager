{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{% block more_fields %}

    {{ fields.dropdownField(
        'GlpiPlugin\\Sprint\\Sprint',
        'plugin_sprint_sprints_id',
        item.fields['plugin_sprint_sprints_id'],
        __('Sprint', 'sprint'),
        field_options
    ) }}

    {{ fields.dropdownArrayField(
        'meeting_type',
        item.fields['meeting_type'],
        meeting_types,
        __('Type', 'sprint'),
        field_options
    ) }}

    {{ fields.datetimeField(
        'date_meeting',
        item.fields['date_meeting'],
        __('Date'),
        field_options
    ) }}

    {{ fields.dropdownNumberField(
        'duration_minutes',
        item.fields['duration_minutes'],
        __('Duration (min)', 'sprint'),
        field_options|merge({
            'min': 5,
            'max': 240,
            'step': 5,
        })
    ) }}

    {% set facilitator_name = member_options[item.fields['users_id']] is defined ? member_options[item.fields['users_id']] : '-' %}
    {{ fields.readOnlyField(
        'users_id',
        facilitator_name,
        __('Facilitator', 'sprint'),
        field_options
    ) }}

    {{ fields.textareaField(
        'notes',
        item.fields['notes'],
        __('Meeting Notes', 'sprint'),
        field_options|merge({
            'rows': 6,
        })
    ) }}

    {# Sprint Items Review — for review/retrospective meetings the guided
       meeting rail replaces this section; the same item tables render inside
       its walkthrough phase (templates/meeting/items_tables.html.twig). #}
    {% if is_existing and sprint_items is defined %}

    <tr><td colspan="4" style="padding:0;">

        {% if guided is defined and guided %}
        {% include '@sprint/meeting/rail.html.twig' %}
        {% else %}
        {% include '@sprint/meeting/items_tables.html.twig' %}
        {% endif %}

        {# The quick-edit dialog, the back-to-backlog dialog and the
           carry-over split dialog are the shared ones rendered by
           SprintMeeting::showForm() (SprintItem::renderQuickEditUI() and
           friends), so labels, validation and feedback match the board,
           dashboard and items tab. Only the meeting's carry-over dropdown
           is wired here. #}
        <script>
        $(function() {
            if (window.__sprintMeetingCarryBound) { return; }
            window.__sprintMeetingCarryBound = true;

            function toast(msg, level) {
                if (window.sprintUi) { window.sprintUi.toast(msg, level); return; }
                try { if (typeof glpi_toast_info === 'function') { glpi_toast_info(msg); } } catch (e) {}
            }
            // Request labels/changes are plain text with names in them: GLPI
            // toasts parse HTML, so they are escaped before joining.
            function esc(s) {
                return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
                    return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];
                });
            }

            // Carry over to another sprint: AJAX so the meeting board
            // confirms in place instead of a full page reload. The original
            // row stays — carrying over is additive. Anyone but the target
            // sprint's Scrum Master files a request, reported as such.
            function runCarryOver($btn, itemId, sprintId, split) {
                var $row = $('tr.sprint-review-row[data-item-id="' + itemId + '"]');
                $btn.addClass('disabled').attr('aria-disabled', 'true');
                $.ajax({
                    url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/csrftoken.php',
                    type: 'GET', dataType: 'json', cache: false
                }).then(function(tokResp) {
                    return $.ajax({
                        url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/carryover.php',
                        type: 'POST', dataType: 'json',
                        data: {
                            id: itemId,
                            plugin_sprint_sprints_id: sprintId,
                            carry_capacity: split.carry_capacity,
                            carry_credits: split.carry_credits,
                            _glpi_csrf_token: tokResp && tokResp.token ? tokResp.token : ''
                        }
                    });
                }).done(function(resp) {
                    if (resp && resp.success && resp.requested) {
                        var lines = (resp.requests || []).filter(function(r) { return r.own; }).map(function(r) {
                            return '• ' + esc(r.label) + (r.change ? ': ' + esc(r.change) : '');
                        });
                        toast('{{ __('Requested — waiting for Scrum Master', 'sprint')|e('js') }}' + (lines.length ? '\n' + lines.join('\n') : '\n' + resp.message), 'warning');
                        $row.find('.sprint-request-pending-badge').remove();
                        var $link = $row.find('td a[href*="sprintitem.form.php"]').not('.btn').first();
                        if ($link.length) {
                            $link.after($('<span class="sprint-request-pending-badge sprint-small" style="display:inline-flex;align-items:center;gap:3px;padding:0 6px;border-radius:8px;background:#fff3cd;color:#664d03;border:1px solid #ffe69c;font-weight:600;white-space:nowrap;"></span>')
                                .attr('title', '{{ __('Requested — waiting for Scrum Master', 'sprint')|e('js') }}')
                                .html('<i class="fas fa-hourglass-half" aria-hidden="true"></i>')
                                .append(document.createTextNode(' {{ __('Requested', 'sprint')|e('js') }}')));
                        }
                    } else if (resp && resp.success) {
                        toast(resp.message, 'success');
                        // Brief green flash on the source row for feedback.
                        $row.css('transition', 'background-color 0.3s').css('background-color', '#d1e7dd');
                        setTimeout(function() { $row.css('background-color', ''); }, 700);
                    } else {
                        toast(resp && resp.message ? resp.message : '{{ __('Could not carry the item over to the target sprint', 'sprint')|e('js') }}', 'error');
                    }
                }).fail(function() {
                    toast('{{ __('Could not reach the server. Try again.', 'sprint')|e('js') }}', 'error');
                }).always(function() {
                    $btn.removeClass('disabled').removeAttr('aria-disabled');
                });
            }

            $(document).on('click', '.sprint-carry-over-btn', function(e) {
                e.preventDefault();
                var $btn      = $(this);
                var itemId    = $btn.data('item-id');
                var sprintId  = $btn.data('sprint-id');
                var sprintLbl = $btn.data('sprint-label') || '';
                var $row      = $('tr.sprint-review-row[data-item-id="' + itemId + '"]');
                var capacity  = parseInt($row.attr('data-is-fastlane'), 10) === 1 ? 0 : (parseFloat($row.attr('data-capacity')) || 0);
                var credits   = parseFloat($row.attr('data-credits')) || 0;

                // With something to split the split dialog is the
                // confirmation (it names the sprint and both halves);
                // otherwise ask plainly, naming the effect.
                if (typeof window.sprintCarrySplit === 'function' && (capacity > 0 || credits > 0)) {
                    window.sprintCarrySplit({ capacity: capacity, credits: credits, sprintLabel: sprintLbl }, function(split) {
                        runCarryOver($btn, itemId, sprintId, split || {});
                    });
                    return;
                }
                var msg = '{{ __('Carry this item over to: %s ? The original stays in the current sprint.', 'sprint')|e('js') }}'.replace('%s', sprintLbl);
                if (confirm(msg)) {
                    runCarryOver($btn, itemId, sprintId, {});
                }
            });
        });
        </script>

    </td></tr>
    {% endif %}

{% endblock %}
