{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{% block more_fields %}

    {{ fields.dropdownField(
        'GlpiPlugin\\Sprint\\Sprint',
        'plugin_sprint_sprints_id',
        item.fields['plugin_sprint_sprints_id'],
        __('Sprint', 'sprint'),
        field_options
    ) }}

    {{ fields.dropdownArrayField(
        'meeting_type',
        item.fields['meeting_type'],
        meeting_types,
        __('Type', 'sprint'),
        field_options
    ) }}

    {{ fields.datetimeField(
        'date_meeting',
        item.fields['date_meeting'],
        __('Date'),
        field_options
    ) }}

    {{ fields.dropdownNumberField(
        'duration_minutes',
        item.fields['duration_minutes'],
        __('Duration (min)', 'sprint'),
        field_options|merge({
            'min': 5,
            'max': 240,
            'step': 5,
        })
    ) }}

    {% set facilitator_name = member_options[item.fields['users_id']] is defined ? member_options[item.fields['users_id']] : '-' %}
    {{ fields.readOnlyField(
        'users_id',
        facilitator_name,
        __('Facilitator', 'sprint'),
        field_options
    ) }}

    {{ fields.textareaField(
        'notes',
        item.fields['notes'],
        __('Meeting Notes', 'sprint'),
        field_options|merge({
            'rows': 6,
        })
    ) }}

    {# Sprint Items Review — for review/retrospective meetings the guided
       meeting rail replaces this section; the same item tables render inside
       its walkthrough phase (templates/meeting/items_tables.html.twig). #}
    {% if is_existing and sprint_items is defined %}

    <tr><td colspan="4" style="padding:0;">

        {% if guided is defined and guided %}
        {% include '@sprint/meeting/rail.html.twig' %}
        {% else %}
        {% include '@sprint/meeting/items_tables.html.twig' %}
        {% endif %}

        <script>
        $(function() {
            var statusColors = {
                'todo':        '#6c757d',
                'in_progress': '#0d6efd',
                'review':      '#6f42c1',
                'done':        '#198754',
                'blocked':     '#dc3545'
            };

            // Back to backlog: ask for a reason first (stored in the item
            // note), then AJAX. When the item is linked to a ticket/change the
            // sprint item stays put (capacity is preserved) and only the
            // underlying item moves to the backlog, so we keep the row and
            // just clear the linked cell. Manual items leave the sprint and
            // their row is removed.
            var $backlogModal = $('#sprint-backlog-reason-modal').detach().appendTo('body');

            function runBackToBacklog(itemId, reason, removeFromSprint, $btn) {
                if ($btn) { $btn.prop('disabled', true); }
                $.ajax({
                    url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/csrftoken.php',
                    type: 'GET', dataType: 'json', cache: false
                }).then(function(tokResp) {
                    return $.ajax({
                        url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/backtobacklog.php',
                        type: 'POST', dataType: 'json',
                        data: {
                            id: itemId,
                            reason: reason,
                            remove_from_sprint: removeFromSprint ? 1 : 0,
                            _glpi_csrf_token: tokResp && tokResp.token ? tokResp.token : ''
                        }
                    });
                }).done(function(resp) {
                    if (resp && resp.success) {
                        try { if (typeof glpi_toast_info === 'function') { glpi_toast_info(resp.message); } } catch (e) {}
                        var $row = $('tr.sprint-review-row[data-item-id="' + itemId + '"]');
                        if (resp.stayed) {
                            // Item stays in the sprint as a manual placeholder.
                            $row.find('.sprint-review-linked')
                                .html('<span class="text-muted fst-italic">{{ __('Moved to backlog', 'sprint') }}</span>');
                            $row.css('transition', 'background-color 0.3s').css('background-color', '#fff3cd');
                            setTimeout(function() { $row.css('background-color', ''); }, 800);
                            if ($btn) { $btn.prop('disabled', false); }
                        } else {
                            $row.fadeOut(150, function() { $(this).remove(); });
                        }
                    } else {
                        alert(resp && resp.message ? resp.message : 'Could not move item back to backlog');
                        if ($btn) { $btn.prop('disabled', false); }
                    }
                }).fail(function() {
                    alert('Network error');
                    if ($btn) { $btn.prop('disabled', false); }
                });
            }

            $(document).on('click', '.sprint-backlog-btn', function() {
                var $btn   = $(this);
                var itemId = $btn.data('backlog-id');
                if (!itemId) { return; }
                $backlogModal.find('textarea[name=reason]').val('');
                $backlogModal.find('.sprint-backlog-reason-error').hide();
                $backlogModal.find('input[name=remove_from_sprint][value="0"]').prop('checked', true);
                $backlogModal.data('target-item', itemId);
                $backlogModal.data('target-btn', $btn);
                var inst = bootstrap.Modal.getOrCreateInstance($backlogModal[0]);
                inst.show();
                setTimeout(function() { $backlogModal.find('textarea[name=reason]').trigger('focus'); }, 200);
            });

            $backlogModal.on('click', '.sprint-backlog-reason-confirm', function() {
                var reason = ($backlogModal.find('textarea[name=reason]').val() || '').trim();
                if (reason === '') {
                    $backlogModal.find('.sprint-backlog-reason-error').show();
                    return;
                }
                $backlogModal.find('.sprint-backlog-reason-error').hide();
                var itemId = $backlogModal.data('target-item');
                var $btn   = $backlogModal.data('target-btn');
                var removeFromSprint = $backlogModal.find('input[name=remove_from_sprint]:checked').val() === '1';
                bootstrap.Modal.getOrCreateInstance($backlogModal[0]).hide();
                runBackToBacklog(itemId, reason, removeFromSprint, $btn);
            });

            // Carry over to another sprint: AJAX call so the meeting board
            // confirms in place (just like "back to backlog") instead of a
            // full page reload. The original row stays — carrying over is
            // additive — so we only flash the row and show a toast.
            $(document).on('click', '.sprint-carry-over-btn', function(e) {
                e.preventDefault();
                var $btn = $(this);
                var itemId    = $btn.data('item-id');
                var sprintId  = $btn.data('sprint-id');
                var sprintLbl = $btn.data('sprint-label') || '';
                var msg = '{{ __('Carry this item over to: %s ? The original stays in the current sprint.', 'sprint') }}'.replace('%s', sprintLbl);
                if (!confirm(msg)) {
                    return;
                }

                $.ajax({
                    url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/csrftoken.php',
                    type: 'GET', dataType: 'json', cache: false
                }).then(function(tokResp) {
                    return $.ajax({
                        url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/carryover.php',
                        type: 'POST', dataType: 'json',
                        data: {
                            id: itemId,
                            plugin_sprint_sprints_id: sprintId,
                            _glpi_csrf_token: tokResp && tokResp.token ? tokResp.token : ''
                        }
                    });
                }).done(function(resp) {
                    if (resp && resp.success) {
                        try { if (typeof glpi_toast_info === 'function') { glpi_toast_info(resp.message); } } catch (e) {}
                        // Brief green flash on the source row for feedback.
                        var $row = $('tr.sprint-review-row[data-item-id="' + itemId + '"]');
                        $row.css('transition', 'background-color 0.3s')
                            .css('background-color', '#d1e7dd');
                        setTimeout(function() { $row.css('background-color', ''); }, 700);
                    } else {
                        alert(resp && resp.message ? resp.message : 'Could not carry the item over');
                    }
                }).fail(function() {
                    alert('Network error');
                });
            });

            // === Quick-edit modal ===
            var $modal = $('#sprint-quickedit-modal').detach().appendTo('body');

            $(document).on('click', '.sprint-quick-edit-btn', function() {
                var $row       = $(this).closest('tr');
                var itemId     = $row.data('item-id');
                var itemName   = $row.data('item-name') || '';
                var status     = $row.data('item-status') || '';
                var priority   = $row.data('item-priority') || 3;
                var usersId    = $row.data('users-id') || 0;
                var points     = $row.data('story-points') || 0;
                var capacity   = $row.data('capacity') || 0;
                var note       = $row.data('note') || '';
                var isFastlane = parseInt($row.data('is-fastlane'), 10) === 1;

                $modal.find('.sprint-qe-title').text(itemName);
                $modal.find('input[name=id]').val(itemId);
                $modal.find('input[name=name]').val(itemName);
                // Linked items mirror the underlying item's name
                // (server-enforced); only manual items are editable.
                (function() {
                    var linkedType = String($row.attr('data-linked-itemtype') || '');
                    $modal.find('input[name=name]')
                        .prop('readonly', linkedType !== '')
                        .attr('title', linkedType !== '' ? '{{ __('The name follows the linked item and cannot be edited here.', 'sprint')|e('js') }}' : '');
                })();
                $modal.find('input[name=is_adhoc]').prop('checked', parseInt($row.data('is-adhoc'), 10) === 1);
                $modal.find('select[name=status]').val(String(status));
                $modal.find('select[name=priority]').val(String(priority));
                $modal.find('select[name=users_id]').val(String(usersId));
                $modal.find('input[name=story_points]').val(points);
                // Match the capacity option numerically ("0.5"/"5.0"/5 all
                // resolve to the same option) so DECIMAL formatting from the
                // database never clears the selection.
                (function() {
                    var $sel = $modal.find('select[name=capacity]');
                    var num  = parseFloat(capacity);
                    if (isNaN(num)) { num = 0; }
                    var match = '';
                    $sel.find('option').each(function() {
                        if (parseFloat(this.value) === num) { match = this.value; return false; }
                    });
                    $sel.val(match);
                })();
                (function() {
                    var $cust = $modal.find('select[name=plugin_sprint_sprintcustomers_id]');
                    if ($cust.length) {
                        // A deactivated customer has no option — inject one so
                        // saving cannot silently drop it; it goes when the next
                        // item opens.
                        var cur = String(parseInt($row.attr('data-customer-id'), 10) || 0);
                        $cust.find('option.sprint-qe-customer-legacy').remove();
                        if (cur !== '0' && !$cust.find("option[value='" + cur + "']").length) {
                            $cust.append($('<option class="sprint-qe-customer-legacy"></option>')
                                .val(cur)
                                .text(($row.attr('data-customer-name') || ('#' + cur)) + ' ({{ __('inactive', 'sprint')|e('js') }})'));
                        }
                        $cust.val(cur);
                    }
                    var $cred = $modal.find('input[name=credits]');
                    if ($cred.length) { $cred.val($row.attr('data-credits') || '0'); }
                    var $prod = $modal.find('select[name=plugin_sprint_sprintcreditproducts_id]');
                    if ($prod.length) {
                        var pid = String(parseInt($row.attr('data-credit-product-id'), 10) || 0);
                        $prod.val($prod.find("option[value='" + pid + "']").length ? pid : '0');
                    }
                })();
                // Category: a row carrying a deactivated category has no
                // matching option — inject one so saving cannot silently reset
                // it to "no category".
                (function() {
                    var $cat = $modal.find('select[name=plugin_sprint_sprintcategories_id]');
                    if (!$cat.length) { return; }
                    var cur = String(parseInt($row.attr('data-category-id'), 10) || 0);
                    $cat.find('option.sprint-qe-cat-legacy').remove();
                    if (cur !== '0' && !$cat.find("option[value='" + cur + "']").length) {
                        $cat.append($('<option class="sprint-qe-cat-legacy"></option>')
                            .val(cur)
                            .text($row.attr('data-category-name') || ('#' + cur)));
                    }
                    $cat.val(cur);
                    if ($cat.val() === null) { $cat.val('0'); }
                })();
                $modal.find('textarea[name=note]').val(note);
                $modal.find('select[name=carry_over_to_sprint_id]').val('0');
                $modal.find('.sprint-qe-error').hide().text('');
                $modal.find('.sprint-qe-story-points, .sprint-qe-capacity').toggle(!isFastlane);
                $modal.find('.sprint-qe-dep-status').hide().removeClass('alert-danger alert-success').addClass('alert-info').text('');
                $modal.find('.sprint-qe-dep-user').val('0');
                $modal.find('.sprint-qe-dep-manage').attr(
                    'href',
                    CFG_GLPI.root_doc + '/plugins/sprint/front/sprintitem.form.php?id=' + encodeURIComponent(itemId) +
                        '&forcetab=' + encodeURIComponent('GlpiPlugin\\Sprint\\SprintItemDependency') + '$1'
                );
                $modal.data('deps-added', 0);

                // Fastlane items have multi-member allocations via the
                // SprintFastlaneMember junction; the single users_id
                // dropdown isn't authoritative. Hide the owner select for
                // those rows and surface the per-user allocations + a
                // shortcut to the manage tab instead.
                var $owner    = $modal.find('.sprint-qe-owner');
                var $fastList = $modal.find('.sprint-qe-fastlane-allocations');
                if (isFastlane) {
                    $owner.hide();
                    $fastList.show();
                    var allocs = [];
                    var raw = $row.attr('data-fastlane-allocations');
                    if (raw) {
                        try { allocs = JSON.parse(raw); } catch (e) { allocs = []; }
                    }
                    var $list = $fastList.find('.sprint-qe-fastlane-list').empty();
                    if (allocs.length === 0) {
                        $list.append(
                            $('<span class="text-muted fst-italic"></span>').text('{{ __('No allocations', 'sprint')|e('js') }}')
                        );
                    } else {
                        var total = 0;
                        allocs.forEach(function(a) {
                            total += parseFloat(a.capacity) || 0;
                            $list.append(
                                $('<div></div>').css({display: 'flex', justifyContent: 'space-between', padding: '2px 0'})
                                    .append($('<span></span>').html('<i class="fas fa-bolt text-warning me-1" style="font-size:0.78em;"></i>').append(document.createTextNode(a.name || '')))
                                    .append($('<strong></strong>').css('color', '#fd7e14').text((a.capacity || 0) + '%'))
                            );
                        });
                        $list.append(
                            $('<div class="text-muted sprint-small mt-1" style="border-top:1px dashed #fd7e14;padding-top:4px;"></div>')
                                .append(document.createTextNode('{{ __('Total', 'sprint')|e('js') }}: '))
                                .append($('<strong></strong>').css('color', '#fd7e14').text(total + '%'))
                        );
                    }
                    var fastUrl = $row.attr('data-fastlane-url') || '';
                    if (fastUrl) {
                        $fastList.find('.sprint-qe-fastlane-manage').attr('href', fastUrl);
                    }
                } else {
                    $owner.show();
                    $fastList.hide();
                }

                // Guarded capacity for non-scrum-master users: the select stays
                // enabled, but the change is sent to the Scrum Master as an
                // approval request instead of applied directly.
                var capacityLocked = {{ capacity_locked ? 'true' : 'false' }};
                $modal.find('.sprint-qe-capacity-hint').toggle(capacityLocked && !isFastlane);

                var m = new bootstrap.Modal($modal[0]);
                m.show();
                $modal.data('bs-instance', m);
            });

            $(document).on('click', '.sprint-qe-save', function() {
                var $btn = $(this);
                var id = $modal.find('input[name=id]').val();

                $modal.find('.sprint-qe-error').hide().text('');

                function runSave(confirmOverflow) {
                    $btn.prop('disabled', true);
                    return $.ajax({
                    url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/csrftoken.php',
                    type: 'GET', dataType: 'json', cache: false
                }).then(function(tokResp) {
                    return $.ajax({
                        url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/updateitemquick.php',
                        type: 'POST', dataType: 'json',
                        data: {
                            id:           id,
                            name:         $modal.find('input[name=name]').val(),
                            // Only the Scrum Master's modal renders the adhoc
                            // switch; jQuery drops undefined values for others.
                            is_adhoc:     $modal.find('input[name=is_adhoc]').length
                                ? ($modal.find('input[name=is_adhoc]').is(':checked') ? 1 : 0)
                                : undefined,
                            status:       $modal.find('select[name=status]').val(),
                            priority:     $modal.find('select[name=priority]').val(),
                            users_id:     $modal.find('select[name=users_id]').val(),
                            story_points: $modal.find('input[name=story_points]').val(),
                            capacity:     $modal.find('select[name=capacity]').val(),
                            plugin_sprint_sprintcustomers_id: $modal.find('select[name=plugin_sprint_sprintcustomers_id]').length
                                ? $modal.find('select[name=plugin_sprint_sprintcustomers_id]').val()
                                : undefined,
                            credits: $modal.find('input[name=credits]').length
                                ? $modal.find('input[name=credits]').val()
                                : undefined,
                            plugin_sprint_sprintcreditproducts_id: $modal.find('select[name=plugin_sprint_sprintcreditproducts_id]').length
                                ? $modal.find('select[name=plugin_sprint_sprintcreditproducts_id]').val()
                                : undefined,
                            note:         $modal.find('textarea[name=note]').val(),
                            plugin_sprint_sprintcategories_id: $modal.find('select[name=plugin_sprint_sprintcategories_id]').length
                                ? $modal.find('select[name=plugin_sprint_sprintcategories_id]').val()
                                : undefined,
                            carry_over_to_sprint_id: $modal.find('select[name=carry_over_to_sprint_id]').val(),
                            meeting_id:   {{ meeting_id|default(0) }},
                            confirm_overflow: confirmOverflow ? 1 : 0,
                            _glpi_csrf_token: tokResp && tokResp.token ? tokResp.token : ''
                        }
                    });
                    });
                }

                function onResp(resp) {
                    if (resp && resp.needs_confirm) {
                        if (window.confirm(resp.message)) {
                            runSave(true).done(onResp).fail(onFail).always(onAlways);
                        } else {
                            $btn.prop('disabled', false);
                        }
                        return;
                    }
                    if (resp && resp.success) {
                        if (resp.carried_over && resp.carry_over_message) {
                            try { if (typeof glpi_toast_info === 'function') { glpi_toast_info(resp.carry_over_message); } } catch (e) {}
                        }
                        // Relay server-side notices (e.g. "capacity change sent
                        // to the Scrum Master for approval").
                        if (resp.message && resp.message !== 'Item updated') {
                            try { if (typeof glpi_toast_info === 'function') { glpi_toast_info(resp.message); } } catch (e) {}
                        }
                        var $row = $('tr.sprint-review-row[data-item-id="' + id + '"]');
                        var statusSelect = $modal.find('select[name=status]');
                        var statusLabel  = statusSelect.find('option:selected').text() || '';
                        var ownerSelect  = $modal.find('select[name=users_id]');
                        var ownerLabel   = ownerSelect.find('option:selected').text() || '';
                        var statusColor  = statusColors[resp.status] || '#6c757d';

                        $row.attr('data-item-name', resp.name).data('item-name', resp.name);
                        $row.attr('data-item-status', resp.status).data('item-status', resp.status);
                        $row.attr('data-item-status-label', statusLabel).data('item-status-label', statusLabel);
                        $row.attr('data-item-priority', resp.priority).data('item-priority', resp.priority);
                        $row.attr('data-users-id', resp.users_id).data('users-id', resp.users_id);
                        $row.attr('data-owner-name', ownerLabel).data('owner-name', ownerLabel);
                        $row.attr('data-story-points', resp.story_points).data('story-points', resp.story_points);
                        $row.attr('data-capacity', resp.capacity).data('capacity', resp.capacity);
                        if (typeof resp.credits !== 'undefined') {
                            $row.attr('data-credits', resp.credits).data('credits', resp.credits);
                            $row.attr('data-customer-id', resp.customer_id).data('customer-id', resp.customer_id);
                            $row.attr('data-credit-product-id', resp.credit_product_id || 0);
                        }
                        $row.attr('data-note', resp.note).data('note', resp.note);

                        $row.find('.sprint-review-status')
                            .text(statusLabel)
                            .css('background-color', statusColor);
                        var $ownerCell = $row.find('.sprint-review-owner');
                        if (parseInt(resp.users_id, 10) > 0 && ownerLabel) {
                            $ownerCell.html('<i class="fas fa-user text-muted me-1"></i>' + $('<div>').text(ownerLabel).html());
                        } else {
                            $ownerCell.html('<span class="text-muted fst-italic">{{ __('Unassigned', 'sprint') }}</span>');
                        }
                        $row.find('.sprint-note-display').text(resp.note || '');

                        $row.find('td a').filter(function() {
                            var $a = $(this);
                            if ($a.hasClass('btn')) { return false; }
                            var href = $a.attr('href');
                            return href && href.indexOf('sprintitem.form.php') !== -1;
                        }).text(resp.name);

                        if (typeof resp.is_adhoc !== 'undefined') {
                            var adhocOn = parseInt(resp.is_adhoc, 10) === 1;
                            $row.attr('data-is-adhoc', adhocOn ? '1' : '0').data('is-adhoc', adhocOn ? 1 : 0);
                            $row.toggleClass('sprint-adhoc', adhocOn);
                            var $nameLink = $row.find('td a').filter(function() {
                                var href = $(this).attr('href');
                                return !$(this).hasClass('btn') && href && href.indexOf('sprintitem.form.php') !== -1;
                            }).first();
                            $row.find('.sprint-adhoc-badge').remove();
                            if (adhocOn && $nameLink.length) {
                                $nameLink.after(
                                    $('<span class="sprint-adhoc-badge" title="{{ __('Added to the sprint after kick-off', 'sprint')|e('js') }}"><i class="fas fa-plus-circle"></i> {{ __('Adhoc', 'sprint')|e('js') }}</span>')
                                );
                            }
                        }

                        // Category pill + attrs. A guarded edit leaves the item
                        // untouched and only queues a request, so the server
                        // value is always the one to render.
                        if (typeof resp.category_id !== 'undefined') {
                            $row.attr('data-category-id', resp.category_id).data('category-id', resp.category_id);
                            $row.attr('data-category-name', resp.category_name || '').data('category-name', resp.category_name || '');
                            $row.find('.sprint-category-pill').remove();
                            if (resp.category_pill_html) {
                                var $catAnchor = $row.find('td a').filter(function() {
                                    var href = $(this).attr('href');
                                    return !$(this).hasClass('btn') && href && href.indexOf('sprintitem.form.php') !== -1;
                                }).first();
                                if ($catAnchor.length) { $catAnchor.after(resp.category_pill_html); }
                            }
                        }

                        if (window.SprintFilter) { window.SprintFilter.applyAll(); }

                        var m = $modal.data('bs-instance');
                        if (m) { m.hide(); }
                    } else {
                        $modal.find('.sprint-qe-error').text(resp && resp.message ? resp.message : 'Save failed').show();
                    }
                }
                function onFail() {
                    $modal.find('.sprint-qe-error').text('Network error').show();
                }
                function onAlways() {
                    $btn.prop('disabled', false);
                }

                runSave(false).done(onResp).fail(onFail).always(onAlways);
            });

            $(document).on('click', '.sprint-qe-dep-add', function() {
                var $btn   = $(this);
                var itemId = $modal.find('input[name=id]').val();
                var userId = parseInt($modal.find('.sprint-qe-dep-user').val(), 10) || 0;
                var cap    = parseFloat($modal.find('.sprint-qe-dep-cap').val()) || 0;
                var $status = $modal.find('.sprint-qe-dep-status');

                if (!itemId || userId <= 0 || cap <= 0) {
                    $status.removeClass('alert-info alert-success').addClass('alert-danger')
                        .text('{{ __('Please select a sprint member and a capacity > 0', 'sprint')|e('js') }}').show();
                    return;
                }
                function runDepAdd(confirmOverflow) {
                    $btn.prop('disabled', true);
                    return $.ajax({
                    url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/csrftoken.php',
                    type: 'GET', dataType: 'json', cache: false
                }).then(function(tokResp) {
                    return $.ajax({
                        url: CFG_GLPI.root_doc + '/plugins/sprint/ajax/dependencyadd.php',
                        type: 'POST', dataType: 'json',
                        data: {
                            plugin_sprint_sprintitems_id: itemId,
                            users_id: userId,
                            capacity: cap,
                            confirm_overflow: confirmOverflow ? 1 : 0,
                            _glpi_csrf_token: tokResp && tokResp.token ? tokResp.token : ''
                        }
                    });
                    });
                }

                function onDepResp(resp) {
                    if (resp && resp.needs_confirm) {
                        if (window.confirm(resp.message)) {
                            runDepAdd(true).done(onDepResp).fail(onDepFail).always(onDepAlways);
                        } else {
                            $btn.prop('disabled', false);
                        }
                        return;
                    }
                    if (resp && resp.success) {
                        if (resp.warning) {
                            $status.removeClass('alert-info alert-success alert-danger').addClass('alert-warning')
                                .text(resp.message + ' — ' + resp.warning).show();
                        } else {
                            $status.removeClass('alert-info alert-danger alert-warning').addClass('alert-success')
                                .text(resp.message).show();
                        }
                        $modal.find('.sprint-qe-dep-user').val('0');
                        $modal.data('deps-added', (parseInt($modal.data('deps-added'), 10) || 0) + 1);

                        // Re-render "Waiting on" cell in place from the new dep list.
                        var $depRow = $('tr.sprint-review-row[data-item-id="' + itemId + '"]');
                        var $depCell = $depRow.find('.sprint-review-deps');
                        if ($depCell.length) {
                            $depCell.empty();
                            var deps = (resp && resp.open_deps) ? resp.open_deps : [];
                            if (deps.length === 0) {
                                $depCell.append(
                                    $('<span class="text-muted fst-italic"></span>').text('{{ __('None', 'sprint')|e('js') }}')
                                );
                            } else {
                                deps.forEach(function(d) {
                                    var $line = $('<div></div>')
                                        .append($('<i class="fas fa-link" style="color:#20c997;font-size:0.75em;"></i>'))
                                        .append(document.createTextNode(' '))
                                        .append(document.createTextNode(d.name || ''))
                                        .append(document.createTextNode(' '))
                                        .append($('<span class="text-muted"></span>').text('(' + (d.capacity || 0) + '%)'));
                                    $depCell.append($line);
                                });
                            }
                        }
                    } else {
                        $status.removeClass('alert-info alert-success').addClass('alert-danger')
                            .text(resp && resp.message ? resp.message : '{{ __('Could not add dependency', 'sprint')|e('js') }}').show();
                    }
                }
                function onDepFail() {
                    $status.removeClass('alert-info alert-success').addClass('alert-danger')
                        .text('Network error').show();
                }
                function onDepAlways() {
                    $btn.prop('disabled', false);
                }

                runDepAdd(false).done(onDepResp).fail(onDepFail).always(onDepAlways);
            });

            $modal.on('hidden.bs.modal', function() {
                $modal.data('deps-added', 0);
            });
        });
        </script>

        {# Quick-edit modal — rendered once, moved out of the form by JS #}
        <div class="modal fade" id="sprint-quickedit-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fas fa-pen me-1"></i>
                            {{ __('Quick edit', 'sprint') }}: <span class="sprint-qe-title"></span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger sprint-qe-error" style="display:none;white-space:pre-line;"></div>
                        <input type="hidden" name="id" value="">

                        <div class="mb-3">
                            <label class="form-label">{{ __('Name') }}</label>
                            <input type="text" name="name" class="form-control" value="">
                        </div>

                        {% if is_scrum_master|default(false) %}
                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="sprint-qe-adhoc" name="is_adhoc">
                            <label class="form-check-label" for="sprint-qe-adhoc">
                                <span class="sprint-adhoc-badge"><i class="fas fa-plus-circle"></i> {{ __('Adhoc', 'sprint') }}</span>
                                {{ __('Added to the sprint after kick-off (highlights the item)', 'sprint') }}
                            </label>
                        </div>
                        {% endif %}

                        {% if categories|default([])|length > 0 %}
                        <div class="mb-3 sprint-qe-category-block">
                            <label class="form-label"><i class="fas fa-folder me-1"></i>{{ __('Category', 'sprint') }}</label>
                            <select name="plugin_sprint_sprintcategories_id" class="form-select">
                                <option value="0">{{ __('No category', 'sprint') }}</option>
                                {% for cid, cat in categories %}
                                <option value="{{ cid }}">{% if cat.level|default(0) > 0 %}&nbsp;&nbsp;&nbsp;— {% endif %}{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                            {% if category_locked|default(false) %}
                            <div class="form-text sprint-small text-warning">
                                <i class="fas fa-user-shield me-1"></i>{{ __('Category changes are sent to the Scrum Master for approval.', 'sprint') }}
                            </div>
                            {% endif %}
                        </div>
                        {% endif %}

                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{{ __('Status') }}</label>
                                <select name="status" class="form-select">
                                    {% for key, label in item_statuses %}
                                    <option value="{{ key }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">{{ __('Priority') }}</label>
                                <select name="priority" class="form-select">
                                    {% for key, label in item_priorities %}
                                    <option value="{{ key }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-3 sprint-qe-owner">
                                <label class="form-label">{{ __('Owner', 'sprint') }}</label>
                                <select name="users_id" class="form-select">
                                    {% for uid, uname in member_options %}
                                    <option value="{{ uid }}">{{ uname }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6 mb-3 sprint-qe-fastlane-allocations" style="display:none;">
                                <label class="form-label">
                                    <i class="fas fa-bolt text-warning me-1"></i>{{ __('Fastlane allocations', 'sprint') }}
                                </label>
                                <div class="sprint-qe-fastlane-list"></div>
                                <a href="#" class="sprint-qe-fastlane-manage btn btn-sm btn-outline-warning mt-2" target="_blank" rel="noopener">
                                    <i class="fas fa-cog me-1"></i>{{ __('Manage fastlane members', 'sprint') }}
                                </a>
                            </div>
                            <div class="col-md-3 mb-3 sprint-qe-story-points">
                                <label class="form-label">{{ __('Story Points', 'sprint') }}</label>
                                <input type="number" name="story_points" class="form-control" min="0" step="1" value="1">
                            </div>
                            <div class="col-md-3 mb-3 sprint-qe-capacity">
                                <label class="form-label">{{ __('Capacity (%)', 'sprint') }}</label>
                                <select name="capacity" class="form-select">
                                    {% for val, label in capacity_choices %}
                                    <option value="{{ val }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                                <div class="form-text sprint-small text-warning sprint-qe-capacity-hint" style="display:none;">
                                    <i class="fas fa-user-shield me-1"></i>{{ __('Capacity changes are sent to the Scrum Master for approval.', 'sprint') }}
                                </div>
                            </div>
                        </div>

                        {% if can_view_credits|default(false) %}
                        <div class="row g-3">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">{{ customer_label }}</label>
                                <select name="plugin_sprint_sprintcustomers_id" class="form-select"{% if not can_edit_credits|default(false) %} disabled{% endif %}>
                                    <option value="0">-----</option>
                                    {% for id, name in customers %}
                                    <option value="{{ id }}">{{ name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">{{ __('Credits', 'sprint') }}</label>
                                <input type="number" name="credits" class="form-control w-100" min="0" step="0.25" value="0"{% if not can_edit_credits|default(false) %} readonly{% endif %}>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-8 mb-3">
                                <label class="form-label"><i class="fas fa-tags me-1"></i>{{ credit_product_label|default('') }}</label>
                                <select name="plugin_sprint_sprintcreditproducts_id" class="form-select sprint-credit-product" data-credits-for="credits"{% if not can_edit_credits|default(false) %} disabled{% endif %}>
                                    <option value="0" data-credits="">{{ __('Manual credits', 'sprint') }}</option>
                                    {% for p in credit_products|default([]) %}
                                    {% if p.is_folder %}
                                    <option value="" disabled>{{ p.label }} 📁</option>
                                    {% else %}
                                    <option value="{{ p.id }}" data-credits="{{ p.credits }}">{{ p.label }}{% if p.credits != '0' %} ({{ p.credits }}){% endif %}</option>
                                    {% endif %}
                                    {% endfor %}
                                </select>
                                <div class="form-text sprint-small text-muted">{{ __('Picking a product fills in its default credits; the amount stays editable.', 'sprint') }}</div>
                            </div>
                        </div>
                        {% endif %}

                        <div class="mb-3">
                            <label class="form-label">{{ __('Note', 'sprint') }}</label>
                            <textarea name="note" class="form-control" rows="8" style="min-height:180px;"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-forward text-success me-1"></i>{{ __('Carry over to sprint', 'sprint') }}
                            </label>
                            <select name="carry_over_to_sprint_id" class="form-select">
                                <option value="0">— {{ __('Do not carry over', 'sprint') }} —</option>
                                {% for target_id, target_label in move_target_sprints %}
                                <option value="{{ target_id }}">{{ target_label }}</option>
                                {% endfor %}
                            </select>
                            <div class="form-text sprint-small text-muted">
                                {{ __('A fresh copy is created in the target sprint. The original stays in this sprint.', 'sprint') }}
                            </div>
                        </div>

                        <div class="mb-3 sprint-qe-deps-block">
                            <label class="form-label">
                                <i class="fas fa-link" style="color:#20c997;margin-right:4px;"></i>{{ __('Dependencies', 'sprint') }}
                            </label>
                            <div class="alert alert-info py-1 sprint-small sprint-qe-dep-status mb-2" style="display:none;"></div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <select class="form-select form-select-sm sprint-qe-dep-user" style="max-width:240px;">
                                    <option value="0">{{ __('Select sprint member', 'sprint') }}</option>
                                    {% for uid, uname in member_options %}
                                    {% if uid > 0 %}
                                    <option value="{{ uid }}">{{ uname }}</option>
                                    {% endif %}
                                    {% endfor %}
                                </select>
                                <select class="form-select form-select-sm sprint-qe-dep-cap" style="max-width:120px;">
                                    {% for val, label in capacity_choices %}
                                    <option value="{{ val }}"{% if val == 5 %} selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-success sprint-qe-dep-add">
                                    <i class="fas fa-plus me-1"></i>{{ __('Add helper', 'sprint') }}
                                </button>
                                <a href="#" class="btn btn-sm btn-outline-secondary sprint-qe-dep-manage" target="_blank" rel="noopener">
                                    <i class="fas fa-external-link-alt me-1"></i>{{ __('Manage dependencies', 'sprint') }}
                                </a>
                            </div>
                            <div class="form-text sprint-small text-muted">
                                {{ __("Couples a colleague to this item with their own capacity %. Open 'Manage' to resolve, reopen or remove.", 'sprint') }}
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Cancel') }}</button>
                        <button type="button" class="btn btn-primary sprint-qe-save">
                            <i class="fas fa-save me-1"></i> {{ __('Save') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="sprint-backlog-reason-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="fas fa-undo me-1"></i> {{ __('Back to backlog', 'sprint') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('Close') }}"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label fw-bold">{{ __('Reason', 'sprint') }}</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="{{ __('Why is this going back to the backlog?', 'sprint') }}"></textarea>
                        <div class="text-danger sprint-small mt-1 sprint-backlog-reason-error" style="display:none;">
                            {{ __('Please enter a reason.', 'sprint') }}
                        </div>
                        <div class="mt-3">
                            <label class="form-label fw-bold d-block">{{ __('What should happen to the sprint item?', 'sprint') }}</label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="remove_from_sprint" value="0" checked>
                                <span class="form-check-label">{{ __('Keep it in the sprint (capacity preserved). Only the linked item returns to the backlog', 'sprint') }}</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="remove_from_sprint" value="1">
                                <span class="form-check-label">{{ __('Also remove the item from the current sprint (move the whole item to the backlog)', 'sprint') }}</span>
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Cancel') }}</button>
                        <button type="button" class="btn btn-warning sprint-backlog-reason-confirm">
                            <i class="fas fa-undo me-1"></i> {{ __('Back to backlog', 'sprint') }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </td></tr>
    {% endif %}

{% endblock %}
