{% extends "generic_show_form.html.twig" %}
{% import "components/form/fields_macros.html.twig" as fields %}

{# The parent template (generic_show_form) auto-renders the standard
   `is_active` and `comment` fields. We deliberately do NOT redeclare
   them here, otherwise they show up twice and the duplicate POST input
   ends up overwriting the user's value with an empty string. #}
{% block more_fields %}

    {{ fields.textField(
        'name_pattern',
        item.fields['name_pattern'],
        __('Name pattern', 'sprint'),
        field_options|merge({
            'helper': __('e.g. Sprint {{number}} - {{project}}', 'sprint'),
        })
    ) }}

    {{ fields.dropdownNumberField(
        'duration_weeks',
        item.fields['duration_weeks'],
        __('Duration (weeks)', 'sprint'),
        field_options|merge({
            'min': 1,
            'max': 8,
        })
    ) }}

    {{ fields.textareaField(
        'goal',
        item.fields['goal'],
        __('Sprint goal', 'sprint'),
        field_options
    ) }}

    {{ fields.numberField('wip_in_progress', item.fields['wip_in_progress'], __('WIP limit: In Progress', 'sprint'), field_options|merge({'min': 0})) }}
    {{ fields.numberField('wip_review', item.fields['wip_review'], __('WIP limit: Review', 'sprint'), field_options|merge({'min': 0})) }}
    {{ fields.numberField('wip_dependency', item.fields['wip_dependency'], __('WIP limit: Dependency', 'sprint'), field_options|merge({'min': 0})) }}
    {{ fields.dropdownArrayField('wip_hard', item.fields['wip_hard'], {0: __('No'), 1: __('Yes')}, __('Enforce WIP limits', 'sprint'), field_options) }}

    {{ fields.dropdownNumberField(
        'fastlane_capacity',
        item.fields['fastlane_capacity'],
        __('Fastlane capacity cap (%)', 'sprint'),
        field_options|merge({
            'min': 0,
            'max': 100,
            'step': 0.5,
            'unit': '%',
            'helper': __('0 = no cap. Exceeding it shows as overflow on the fastlane', 'sprint'),
        })
    ) }}

{% endblock %}
